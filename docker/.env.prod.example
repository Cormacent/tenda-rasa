# ============================================================
# Production Environment Variables
# Copy this file to .env.prod and fill in real values
# ============================================================

# --- Postgres (aplikasi utama) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GANTI_DENGAN_PASSWORD_Kuat>
POSTGRES_DB=tendarasa_db
# Hostname harus sama dengan nama service di docker-compose
POSTGRES_HOST=postgres
# Port yang di-expose ke host (untuk akses dari luar container)
PG_PORT=5432

# --- Postgres (khusus n8n) ---
N8N_POSTGRES_USER=n8n_user
N8N_POSTGRES_PASSWORD=<GANTI_DENGAN_PASSWORD_Kuat>
N8N_POSTGRES_DB=n8n_db

# --- n8n ---
N8N_PORT=5678
# URL webhook harus accessible dari internet (bukan localhost/ngrok)
# Untuk production, gunakan domain nyata atau VPN
WEBHOOK_URL=https://your-domain.com/webhook
GEMINI_API_KEY=<GANTI_DENGAN_API_KEY_Gemini>

# --- Backend ---
# Port internal container (jangan diubah)
BE_PORT=3000
BE_SOCKET_PORT=3000

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Frontend (VITE_* di-bake saat FE docker build, bukan runtime) ---
# Untuk production, gunakan domain BE yang accessible dari browser
# Contoh: https://api.tendarasa.com/api/v1
VITE_API_WEBSOCKET=http://localhost:3000
VITE_API_BACKEND=http://localhost:3000/api/v1

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=<GANTI_DENGAN_Builder_API_Key>
