# Template variabel untuk docker-compose (local dev & staging).
# Copy jadi .env (local) atau .env.dev (staging), lalu isi value asli.
# JANGAN commit .env / .env.dev yang sudah berisi value asli.

# --- Postgres (aplikasi utama) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
# Dipakai untuk koneksi internal antar-container MAUPUN akses dari host (docker port mapping "PG_PORT:5432")
PG_PORT=5432

# --- Postgres (khusus n8n) ---
N8N_POSTGRES_USER=
N8N_POSTGRES_PASSWORD=
N8N_POSTGRES_DB=

# --- n8n ---
N8N_PORT=5678
WEBHOOK_URL=
GEMINI_API_KEY=

# --- Backend ---
BE_PORT=3001
BE_SOCKET_PORT=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Frontend (dipakai saat build FE ikut di-orchestrate lewat env ini) ---
VITE_API_N8N=
VITE_API_WEBSOCKET=
VITE_API_BACKEND=
VITE_PUBLIC_BUILDER_KEY=
