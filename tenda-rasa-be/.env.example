# Template variabel untuk backend (local dev & staging).
# Copy jadi .env (local) atau .env.dev (staging), lalu isi value asli.
# JANGAN commit .env / .env.dev yang sudah berisi value asli.

NODE_ENV=development
PORT=3000
# Origin FE yang boleh akses API ini, pisahkan koma kalau lebih dari satu
# (contoh staging: http://localhost:5173,https://tenda-rasa.netlify.app)
CORS_ORIGIN=http://localhost:5173

# --- Postgres ---
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
PG_PORT=
POOL_MODE=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=

# --- Lain-lain ---
GEMINI_API_KEY=
BE_SOCKET_PORT=
VUE_URL=
