    {
      "parameters": {
        "jsCode": "const geminiReply = $item(0).$node[\"Extract Intent\"].json.replyClean;\nconst menuIds = $item(0).$node[\"Extract Intent\"].json.menuIds ?? [];\nconst menus = $items(\"Get All Menu\");\n\nconst matchedMenus = menus\n  .filter(i => menuIds.includes(i.json.id))\n  .map(i => i.json);\n\nconst deskripsi = matchedMenus.map(m => `**${m.menu_name}**: ${m.description}`).join('\\n');\n\nreturn [{\n  json: {\n    reply: `${geminiReply}\\n\\n${deskripsi}`\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
