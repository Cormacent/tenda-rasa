    {
      "parameters": {
        "jsCode": "const geminiReply = $item(0).$node[\"Extract Intent\"].json.replyClean;\nconst menuIds = $item(0).$node[\"Extract Intent\"].json.menuIds ?? [];\n\nconst menus = $items(\"Get All Menu\");\n\nconst matchedMenus = menus\n  .map(i => i.json)\n  .filter(menu => menuIds.includes(menu.id));\n\nreturn [{\n  json: {\n    reply: geminiReply,\n    menu: matchedMenus\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
